{
  "name": "haowu-mall",
  "private": true,
  "version": "1.0.0",
  "description": "好物商城 — full-stack e-commerce demo",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build:functions": "wrangler pages functions build --outdir=dist/worker",
    "db:init": "wrangler d1 execute haowu_mall --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute haowu_mall --remote --file=schema.sql",
    "dev": "npm run build:functions && wrangler dev",
    "deploy": "npm run build:functions && wrangler deploy",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.0.0"
  }
}
